# Copy to .env.local and fill in. .env.local is git-ignored.
# On Vercel, set the same names under Project → Settings → Environment Variables.

# Supabase (database and private file storage). Without these, the app uses a local database in data/pglite.
# DATABASE_URL: Connect → Transaction pooler (port 6543), with the database password filled in.
DATABASE_URL=
SUPABASE_URL=
# Server-only secret. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Daily practice (see vercel.json "crons"). Vercel sets this header itself; set the same value here
# and in the Vercel project so nobody else can trigger the morning send.
CRON_SECRET=

# Google AI Studio key (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Models (free tier as of 2026-09). Change here if Google renames them.
GEMINI_MODEL_MAIN=gemini-3.8-flash
GEMINI_MODEL_LIGHT=gemini-3.5-flash-lite

# Claude (Anthropic). When set, Onside uses Claude instead of Gemini.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_HELPER=claude-haiku-4-5
ANTHROPIC_MODEL_LEAK=claude-haiku-4-5
ANTHROPIC_MODEL_MARKING=claude-sonnet-5
ANTHROPIC_MODEL_GENERATE=claude-sonnet-5
AI_MARKING_BATCH=on
HELPER_DAILY_LIMIT=15

# Telegram, for a message when a student submits. Both are needed; without them nothing is sent.
# TELEGRAM_BOT_TOKEN: talk to @BotFather, /newbot, and copy the token it gives you.
# TELEGRAM_CHAT_ID: message your new bot once, then run `npm run notify:chatid`
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# The address of this deployment, so the message can link to the marking screen.
ONSIDE_URL=
